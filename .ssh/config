Host github.com
    IdentityFile ~/.ssh/id_rsa

Host *.sciencephoto.local
    ServerAliveInterval 600
    TCPKeepAlive yes
    ForwardAgent yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600

# Most SPL hosts use ssh-rsa
    PubkeyAcceptedKeyTypes +ssh-rsa
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedKeyTypes +ssh-rsa

Host *
  PubkeyAcceptedKeyTypes +ssh-rsa
  HostKeyAlgorithms +ssh-rsa
  PubkeyAcceptedKeyTypes +ssh-rsa

# Try to debug crashing sessions
Host sirius
  LogLevel VERBOSE

Host spl-dev-07
  User dpaikkos
# Hostname 192.168.0.120
  Port 22
  TCPKeepAlive yes
  Compression yes
  ForwardAgent yes

